# ===== 数据库 =====
DB_PASSWORD=changeme
DB_PORT=5432

# ===== Redis =====
REDIS_PORT=6379

# ===== JWT =====
JWT_ACCESS_SECRET=替换成 openssl rand -hex 32 的输出
JWT_REFRESH_SECRET=替换成 openssl rand -hex 32 的输出

# ===== 加密密钥（AES-256） =====
ENCRYPTION_KEY=替换成 openssl rand -hex 32 的输出
BACKUP_ENCRYPT_KEY=替换成 openssl rand -hex 32 的输出

# ===== 站点 =====
SITE_URL=https://your-domain.com

# ===== 短信（生产环境关闭） =====
SMS_DEV_MODE=0

# ===== 上传 =====
UPLOAD_DRIVER=local

# ===== 端口 =====
APP_PORT=8182
