// ============================================================
// 职桥 JobBridge —— 人力资源招聘平台
// Prisma Schema (v2.1)
// PostgreSQL 16+ (本机 18.1)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= 枚举 =================
enum Role {
  CANDIDATE
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum CompanyVerifyStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CompanyStatus {
  ACTIVE
  CLOSED
}

enum CompanyMemberRole {
  OWNER
  HR
  VIEWER
}

enum CompanyMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum JobClosedReason {
  ADMIN
  COMPANY
  QUOTA_EXCEEDED
  AUDIT_REJECTED
}

enum JobAuditStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalaryUnit {
  MONTH_K
  DAY_YUAN
  HOUR_YUAN
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACT
}

enum Experience {
  FRESH
  Y1_3
  Y3_5
  Y5
}

enum ReviewType {
  COMPANY
  CANDIDATE
}

enum ReplyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentChannel {
  ALIPAY
  WECHAT
  STRIPE
}

enum PaymentType {
  SUBSCRIPTION
  RECHARGE
}

enum ReportTargetType {
  COMPANY
  JOB
  REVIEW
  USER
}

enum ReportStatus {
  PENDING
  HANDLED
  DISMISSED
}

enum UserEventType {
  VIEW
  FAVORITE
  CHAT
}

enum NotificationType {
  NEW_MESSAGE
  NEW_REVIEW
  REVIEW_REPLY
  JOB_AUDIT
  COMPANY_VERIFY
  PLAN_EXPIRE
  BOOST_OVERTAKEN
  BOOST_BALANCE_LOW
  SYSTEM
}

enum NotificationChannel {
  INAPP
  SMS
  EMAIL
}

enum AnnouncementType {
  BANNER
  NOTICE
}

enum AuditMode {
  PRE
  POST
}

enum BackupType {
  FULL
  SCHEMA_DATA
}

enum BackupFormat {
  SQL
  CUSTOM
}

enum DbBackupType {
  MANUAL
  AUTO
  PRE_RESTORE_SNAPSHOT
}

enum DbBackupStatus {
  RUNNING
  OK
  FAILED
  DELETED
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum PolicySource {
  REGISTER
  LOGIN
  IN_APP_PROMPT
}

enum SensitiveWordScope {
  ALL
  JOB
  REVIEW
  CHAT
}

enum SmsProviderType {
  ALIYUN
  TENCENT
  VOLCENGINE
}

enum SmsPurpose {
  LOGIN
  RESET
  VERIFY
}

enum SeekerPostStatus {
  OPEN
  CLOSED
}

enum SeekerPostClosedReason {
  USER_DELETED
  USER_CLOSED
}

enum CallLogType {
  JOB
  SEEKER_POST
}

enum ReviewScope {
  JOB
  HOURLY
}

enum HourlyApplicationStatus {
  APPLIED
  CANCELLED
}

enum JobBiddingBoostStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

enum BoostJobType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACT
  HOURLY
}

enum WalletTransactionType {
  RECHARGE
  CONSUME
  FREEZE
  UNFREEZE
  REFUND
  ADJUST
}

// ================= 用户 =================
model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                 String?   @unique @db.VarChar(20)
  email                 String?   @unique @db.VarChar(255)
  password_hash         String?   @db.VarChar(255)
  name                  String    @db.VarChar(50)
  avatar                String?   @db.VarChar(500)
  bio                   String?
  role                  Role      @default(CANDIDATE)
  title                 String?   @db.VarChar(100)
  city                  String?   @db.VarChar(50)
  skills                String[]  @db.Text
  status                UserStatus @default(ACTIVE)
  chat_muted_until      DateTime? @db.Timestamptz
  refresh_token_version Int       @default(0)
  deleted_at            DateTime? @db.Timestamptz
  last_login_at         DateTime? @db.Timestamptz
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @updatedAt @db.Timestamptz

  companies             CompanyMember[]
  conversations         Conversation[]        @relation("ConversationCandidate")
  sent_messages         Message[]
  reviews_given         Review[]              @relation("ReviewReviewer")
  reviews_received      Review[]              @relation("ReviewCandidate")
  favorites             Favorite[]
  reports               Report[]
  user_events           UserEvent[]
  notifications         Notification[]
  audit_logs            AuditLog[]
  payments_reviewed     Review[]              @relation("ReplyReviewedBy")
  policy_agreements     UserPolicyAgreement[]
  policies_created      Policy[]              @relation("PolicyCreatedBy")
  policies_published    Policy[]              @relation("PolicyPublishedBy")
  seeker_posts          SeekerPost[]
  call_logs_caller      CallLog[]             @relation("CallLogCaller")
  call_logs_callee      CallLog[]             @relation("CallLogCallee")
  db_backups            DbBackup[]
  companies_owned       Company[]
  hourly_applications   HourlyJobApplication[]
  reviews_replied       Review[]              @relation("ReviewReplyBy")

  @@index([status, role])
  @@index([city])
}

model PhoneReleasePool {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String   @unique @db.VarChar(20)
  released_at DateTime @default(now()) @db.Timestamptz
  old_user_id String?  @db.Uuid

  @@index([phone, released_at])
}

// ================= 行业 / 职位名称 (v2.1) =================
model Industry {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id  String?    @db.Uuid
  name       String     @db.VarChar(50)
  code       String     @unique @db.VarChar(20)
  sort       Int        @default(0)
  active     Boolean    @default(true)
  created_at DateTime   @default(now()) @db.Timestamptz
  updated_at DateTime   @updatedAt @db.Timestamptz

  parent      Industry?  @relation("IndustryChildren", fields: [parent_id], references: [id])
  children    Industry[] @relation("IndustryChildren")
  companies   Company[]
  jobs        Job[]

  @@index([parent_id])
  @@index([active, sort])
}

model JobTitle {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category     String   @db.VarChar(50)
  sub_category String?  @db.VarChar(50)
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(30)
  sort         Int      @default(0)
  active       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  jobs Job[]

  @@index([category, sub_category])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([active, sort])
}

// ================= 企业 =================
model Company {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id      String               @db.Uuid
  name          String               @db.VarChar(100)
  logo          String?              @db.VarChar(500)
  industry_id   String?              @db.Uuid
  size          String?              @db.VarChar(20)
  location      String?              @db.VarChar(100)
  contact_phone String?              @db.VarChar(20)
  website       String?              @db.VarChar(200)
  description   String?
  founded_at    DateTime?            @db.Date
  verify_status CompanyVerifyStatus  @default(PENDING)
  status        CompanyStatus        @default(ACTIVE)
  avg_rating    Decimal              @default(0) @db.Decimal(2, 1)
  review_count  Int                  @default(0)
  created_at    DateTime             @default(now()) @db.Timestamptz
  updated_at    DateTime             @updatedAt @db.Timestamptz

  owner         User                 @relation(fields: [owner_id], references: [id])
  industry      Industry?            @relation(fields: [industry_id], references: [id])
  members       CompanyMember[]
  jobs          Job[]
  conversations Conversation[]
  subscriptions Subscription[]
  payments      Payment[]
  reviews       Review[]             @relation("CompanyReviews")
  wallet        CompanyWallet?
  wallet_transactions WalletTransaction[]
  bidding_boosts JobBiddingBoost[]

  @@index([owner_id])
  @@index([verify_status])
  @@index([industry_id])
}

model CompanyMember {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String              @db.Uuid
  user_id    String              @db.Uuid
  role       CompanyMemberRole   @default(HR)
  status     CompanyMemberStatus @default(ACTIVE)
  is_primary_contact Boolean      @default(false)
  created_at DateTime            @default(now()) @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([company_id, user_id])
  @@index([user_id, status])
}

// ================= 职位标签（预定义） =================
model JobTag {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String @unique @db.VarChar(20)
  sort  Int    @default(0)

  created_at DateTime @default(now()) @db.Timestamptz
}

// ================= 职位 =================
model Job {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String          @db.Uuid
  industry_id   String?         @db.Uuid
  job_title_id  String?         @db.Uuid
  title         String          @db.VarChar(100)
  description   String
  salary_min    Int?
  salary_max    Int?
  salary_unit   SalaryUnit      @default(MONTH_K)
  city          String          @db.VarChar(50)
  job_type      JobType
  experience    Experience?
  education     String?         @db.VarChar(20)
  tags          String[]        @db.Text
  status        JobStatus       @default(OPEN)
  closed_reason JobClosedReason?
  audit_status  JobAuditStatus  @default(APPROVED)
  is_featured   Boolean         @default(false)
  is_hourly     Boolean         @default(false)
  hourly_rate   Decimal?        @db.Decimal(10, 2)
  work_period   String?         @db.VarChar(100)
  slots         Int             @default(1)
  applied_count Int             @default(0)
  lat           Decimal?        @db.Decimal(9, 6)
  lng           Decimal?        @db.Decimal(9, 6)
  views         Int             @default(0)
  deleted_at    DateTime?       @db.Timestamptz
  created_at    DateTime        @default(now()) @db.Timestamptz
  updated_at    DateTime        @updatedAt @db.Timestamptz

  company       Company         @relation(fields: [company_id], references: [id])
  industry      Industry?       @relation(fields: [industry_id], references: [id])
  job_title     JobTitle?       @relation(fields: [job_title_id], references: [id])
  conversations Conversation[]
  favorites     Favorite[]
  user_events   UserEvent[]
  boosts        JobBoost[]
  bidding_boosts JobBiddingBoost[]
  hourly_applications HourlyJobApplication[]
  recommendationBlacklists RecommendationBlacklist[]

  @@index([company_id])
  @@index([status, created_at])
  @@index([city])
  @@index([industry_id])
  @@index([job_title_id])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lat, lng])
}

// 推荐人工干预（加权/降权/强制曝光）
model JobBoost {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id     String   @db.Uuid
  boost      Decimal  @default(0) @db.Decimal(4, 2) // 正值加权 负值降权
  forced     Boolean  @default(false) // 强制曝光位
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id])
}

// 推荐黑名单
model RecommendationBlacklist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id])
}

// ================= 小时工 =================
model HourlyJobApplication {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id     String                  @db.Uuid
  user_id    String                  @db.Uuid
  status     HourlyApplicationStatus @default(APPLIED)
  created_at DateTime                @default(now()) @db.Timestamptz

  job     Job      @relation(fields: [job_id], references: [id])
  user    User     @relation(fields: [user_id], references: [id])
  reviews Review[]

  @@unique([job_id, user_id])
  @@index([user_id, status])
  @@index([job_id, status])
}

// ================= 竞价置顶（job_boosts） =================
model JobBiddingBoost {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String                @db.Uuid
  job_id     String                @db.Uuid
  city       String                @db.VarChar(50)
  job_type   BoostJobType?
  bid        Decimal               @default(0) @db.Decimal(10, 2)
  status     JobBiddingBoostStatus @default(PENDING)
  start_date DateTime              @db.Date
  end_date   DateTime              @db.Date
  paused_at  DateTime?             @db.Timestamptz // 暂停时间（恢复时用于顺延结束日期）
  total_cost Decimal               @default(0) @db.Decimal(10, 2)
  created_at DateTime              @default(now()) @db.Timestamptz
  updated_at DateTime              @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id])
  job     Job     @relation(fields: [job_id], references: [id])

  @@unique([job_id, city])
  @@index([city, status, bid(sort: Desc)])
  @@index([company_id, status])
}

// ================= 企业余额 =================
model CompanyWallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String   @unique @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  frozen         Decimal  @default(0) @db.Decimal(10, 2)
  total_recharge Decimal  @default(0) @db.Decimal(10, 2)
  total_consume  Decimal  @default(0) @db.Decimal(10, 2)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
}

model WalletTransaction {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String               @db.Uuid
  type          WalletTransactionType
  amount        Decimal              @db.Decimal(10, 2)
  balance_after Decimal              @db.Decimal(10, 2)
  order_no      String?              @db.VarChar(64)
  description   String?              @db.VarChar(200)
  created_at    DateTime             @default(now()) @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([type, created_at])
}

// ================= 聊天 =================
model Conversation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id          String?   @db.Uuid
  seeker_post_id  String?   @db.Uuid
  candidate_id    String    @db.Uuid
  company_id      String    @db.Uuid
  last_message_at DateTime  @default(now()) @db.Timestamptz
  closed_at       DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  job         Job?          @relation(fields: [job_id], references: [id])
  seeker_post SeekerPost?   @relation("ConversationSeekerPost", fields: [seeker_post_id], references: [id])
  candidate   User          @relation("ConversationCandidate", fields: [candidate_id], references: [id])
  company     Company       @relation(fields: [company_id], references: [id])
  messages    Message[]
  reviews     Review[]

  @@unique([candidate_id, company_id, job_id])
  @@unique([candidate_id, company_id, seeker_post_id])
  @@index([company_id, last_message_at])
  @@index([candidate_id, last_message_at])
}

model Message {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String    @db.Uuid
  sender_id       String    @db.Uuid
  content         String
  read_at         DateTime? @db.Timestamptz
  is_deleted      Boolean   @default(false)
  deleted_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id])

  @@index([conversation_id, created_at])
}

// ================= 评价 =================
model Review {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewer_id      String     @db.Uuid
  reviewee_type    ReviewType
  company_id       String?    @db.Uuid
  candidate_id     String?    @db.Uuid
  conversation_id  String?    @db.Uuid
  scope            ReviewScope @default(JOB)
  hourly_application_id String? @db.Uuid
  rating           Int        @db.SmallInt
  content          String     @db.VarChar(500)
  reply            String?    @db.VarChar(500)
  reply_by         String?    @db.Uuid
  reply_status     ReplyStatus @default(APPROVED)
  reply_reviewed_by String?   @db.Uuid
  edited_at        DateTime?  @db.Timestamptz
  edit_count       Int        @default(0) @db.SmallInt
  deleted_at       DateTime?  @db.Timestamptz
  deleted_by       String?    @db.Uuid
  created_at       DateTime   @default(now()) @db.Timestamptz
  updated_at       DateTime   @updatedAt @db.Timestamptz

  reviewer     User       @relation("ReviewReviewer", fields: [reviewer_id], references: [id])
  company      Company?   @relation("CompanyReviews", fields: [company_id], references: [id])
  candidate    User?      @relation("ReviewCandidate", fields: [candidate_id], references: [id])
  conversation Conversation? @relation(fields: [conversation_id], references: [id])
  hourly_application HourlyJobApplication? @relation(fields: [hourly_application_id], references: [id])
  reply_reviewed_by_user User? @relation("ReplyReviewedBy", fields: [reply_reviewed_by], references: [id])
  reply_by_user  User?    @relation("ReviewReplyBy", fields: [reply_by], references: [id])

  @@unique([reviewer_id, conversation_id])
  @@unique([reviewer_id, hourly_application_id])
  @@index([company_id, deleted_at])
  @@index([candidate_id, deleted_at])
  @@index([scope])
  @@index([reviewer_id, scope])
}

// ================= 收藏 =================
model Favorite {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  job_id     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])
  job  Job  @relation(fields: [job_id], references: [id])

  @@unique([user_id, job_id])
}

// ================= 会员 / 订阅 / 支付 =================
model Plan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(50)
  price_monthly   Decimal? @db.Decimal(10, 2)
  price_yearly    Decimal? @db.Decimal(10, 2)
  job_limit       Int
  can_feature     Boolean  @default(false)
  can_view_contacts Boolean @default(false)
  duration_days   Int
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  subscriptions Subscription[]
  payments      Payment[]
}

model Subscription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String             @db.Uuid
  plan_id    String             @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  start_at   DateTime           @db.Timestamptz
  end_at     DateTime           @db.Timestamptz
  created_at DateTime           @default(now()) @db.Timestamptz
  updated_at DateTime           @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id])
  plan    Plan    @relation(fields: [plan_id], references: [id])

  @@index([company_id])
  @@index([status, end_at])
}

model Payment {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_no   String        @unique @db.VarChar(64)
  company_id String        @db.Uuid
  plan_id    String?       @db.Uuid
  type       PaymentType   @default(SUBSCRIPTION)
  amount     Decimal       @db.Decimal(10, 2)
  channel    PaymentChannel
  status     PaymentStatus @default(PENDING)
  paid_at    DateTime?     @db.Timestamptz
  note       String?       @db.VarChar(200)
  created_at DateTime      @default(now()) @db.Timestamptz
  updated_at DateTime      @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id])
  plan    Plan?   @relation(fields: [plan_id], references: [id])

  @@index([company_id])
  @@index([status])
}

// ================= 举报 / 行为 / 通知 / 审计 =================
model Report {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id String          @db.Uuid
  target_type ReportTargetType
  target_id  String           @db.Uuid
  reason     String           @db.VarChar(200)
  status     ReportStatus     @default(PENDING)
  handled_by String?          @db.Uuid
  created_at DateTime         @default(now()) @db.Timestamptz
  updated_at DateTime         @updatedAt @db.Timestamptz

  reporter User @relation(fields: [reporter_id], references: [id])

  @@index([status])
}

model UserEvent {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String        @db.Uuid
  job_id     String        @db.Uuid
  event_type UserEventType
  weight     Int           @db.SmallInt
  created_at DateTime      @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])
  job  Job  @relation(fields: [job_id], references: [id])

  @@index([user_id, event_type, created_at])
}

model Notification {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String              @db.Uuid
  type       NotificationType
  title      String              @db.VarChar(100)
  body       String?             @db.VarChar(500)
  link       String?             @db.VarChar(300)
  channel    NotificationChannel @default(INAPP)
  read_at    DateTime?           @db.Timestamptz
  created_at DateTime            @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, read_at])
  @@index([created_at])
}

model NotificationTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type     String   @unique @db.VarChar(50)
  title_template String   @db.VarChar(100)
  body_template  String   @db.VarChar(500)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  rules NotificationRule[]
}

model NotificationRule {
