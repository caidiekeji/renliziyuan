// ================= 评价算法配置 =================
model RatingConfig {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // 时间衰减权重：评价距今 X 个月内权重为 W
  decay_tier1_months  Int     @default(3)    // 第一档：近 N 个月
  decay_tier1_weight  Float   @default(1.0)  // 第一档权重
  decay_tier2_months  Int     @default(12)   // 第二档：N 个月内
  decay_tier2_weight  Float   @default(0.5)  // 第二档权重
  decay_tier3_weight  Float   @default(0.25) // 第三档：超出第二档

  // 评分降权：低于阈值的企业在搜索排序中降权
  low_rating_threshold Float  @default(3.0)  // 低于此评分触发降权
  penalty_factor       Float  @default(0.5)  // 降权系数（0-1，越小越靠后）

  // 评价数不足保护：评价数低于阈值时使用平台默认评分
  min_reviews_for_real  Int   @default(3)    // 最少评价数才使用真实评分
  fallback_rating       Float @default(3.5)  // 评价数不足时的默认评分

  // 推荐算法中的评分权重
  w_rating Float @default(0.15)              // 推荐打分中评分的权重

  updated_at DateTime @updatedAt @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
}
